# Copy to .env.local (gitignored) for local development. Never commit real values.
# 'mock' = in-memory fake data, no backend. 'supabase' = real backend (default when unset).
VITE_DATA_MODE=
# Supabase project URL (https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=
# Supabase anon (public) key. Row Level Security is what protects the data, not this key.
VITE_SUPABASE_ANON_KEY=
